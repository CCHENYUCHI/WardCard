# 伺服器監聽連接埠 (Oracle Cloud 建議使用 3000 或 80)
PORT=3000

# Google Gemini API Key (可在此設定，或由使用者在前端設定頁面輸入)
# 前往 https://aistudio.google.com/app/apikey 免費領取
GEMINI_API_KEY=

# Gemini 模型設定 (主模型失敗、限流或下架時自動改用備援模型)
# 可用模型清單：https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 時區：「今日任務」以此時區的 00:00 換日（未設定時預設 Asia/Taipei）
TZ=Asia/Taipei
